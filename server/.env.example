# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database Engine: 'firebase' (default) | 'local'
DB_TYPE=firebase

# ============================================================================
# Google Firebase / Cloud Firestore Configuration
# ============================================================================
# Option A: Path to your Firebase service account JSON key file:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual Firebase Service Account credentials (ideal for cloud deployments):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id.firebaseio.com

# ============================================================================
# Google Gemini API Key
# ============================================================================
# (Optional: intelligent offline fallbacks are automatically active when omitted)
GEMINI_API_KEY=your_gemini_api_key_here
